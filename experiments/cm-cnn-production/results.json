 "meta": {
  "phase": "E.2",
  "title": "Production CNN matrix: six official torchvision checkpoints, dense vs CM gates",
  "engine": "native/cm_production_avx512.cpp (AVX-512, single thread, -O3 -march=native)",
  "host": "32 x86-64 cores, AVX-512F/BW/VL, FMA",
  "compiler": "g++ (GCC) 16.2.1 20260810",
  "threads": 1,
  "reps_static": 2,
  "reps_stream": 3,
  "kernel": "tiled 2x2 output tiles, 4-pixel SIMD batches, masked 16-lane AVX-512 conv/dw kernels",
  "p1": "P1 batching: within a smooth 2x2 tile one representative pixel is convolved and replicated",
  "p2": "P2 temporal cache: per-frame 2x2 input-tile diff (mean L1 over the 12 channel values) against tau = max(2.5% of the frame's dynamic range, median + 4 MAD); a 3x3 majority filter drops spatially uncorrelated grain (a tile survives if >= 5 of its 9 neighbours are dirty); one 8-neighbour dilation; a frame-wide guard flushes when more than 40% of input tiles exceed the absolute floor (rigid global change); the base grid is then projected onto every node's own 2x2 tile grid and MAC-weighted into one recompute share, and the frame is flushed to the dense kernels when that share > 0.50",
  "calibration": "eps/near-boundary slicing is recomputed per run; the P1 alpha sweep is inert for these models, so eps=0 is what the engine actually used",
  "accuracy_note": "ImageNet top-1 accuracy is not reported: the 10-class labels of the synthetic test set are arbitrary, so `accuracy` is 0.0 by construction and every fidelity claim is made against the dense M0 logits of the same image",
  "dataset": "experiments/cm-cnn-production/dataset (32 test images, 96 dev images, 36-frame stress streams R1-R6)",
  "weights_are_public_official": true,
  "no_retraining": true,
  "torch_validation": {
   "script": "scripts/check_production_against_torch.py",
   "max_abs_logit_diff": {
    "resnet18": 0.000682830810546875,
    "resnet50": 0.00084686279296875,
