{
  "name": "ucz",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "benchmark": "node benchmark/server.mjs",
    "build": "npm run build:worker && node scripts/build-dist.mjs",
    "preview": "vite preview",
    "test:p141:bounded": "node tests/p141-implementation.test.mjs",
    "test:ui": "node tests/run-ui.mjs",
    "test:codec": "node tests/run.mjs && node tests/worker.mjs && node --test tests/p10-baseline.test.mjs && node --test tests/p122-diagnostics.test.mjs && node --test tests/p13-diagnostics.test.mjs",
    "bench": "node scripts/run-bench.mjs",
    "diag:p9": "node scripts/diag/run-p9.mjs",
    "test:p9-recovery": "node --test tests/p9-recovery.test.mjs",
    "pretest:codec": "node scripts/build-worker-code.mjs --check",
    "test:p9-format": "node tests/run-p9-format.mjs",
    "test:p9-macro": "node tests/run-p9-macro.mjs",
    "check:worker": "node scripts/build-worker-code.mjs --check",
    "test:p9-defaults": "node tests/run-p9-defaults.mjs",
    "test:p10": "node tests/run-p10.mjs && node --test tests/p10-baseline.test.mjs",
    "test:p11": "node tests/run-p11.mjs && node --test tests/p10-baseline.test.mjs",
    "test:p111": "node tests/run-p111.mjs && node --test tests/p10-baseline.test.mjs",
    "build:worker": "node scripts/build-worker-code.mjs",
    "test:codec:bounded": "node tests/run-p12.mjs",
    "test:p131:bounded": "node tests/run-p131.mjs",
    "test:p13-diagnostics": "node --test tests/p13-diagnostics.test.mjs",
    "test:p13:bounded": "node tests/run-p13.mjs",
    "test:p12-diagnostics": "node --test tests/p122-diagnostics.test.mjs",
    "bench:corpus": "node scripts/run-bench.mjs",
    "bench:silesia": "node scripts/run-bench.mjs --corpus .diag-data/corpus --out bench-out/silesia --baseline",
    "bench:aitdcc": "node scripts/run-bench.mjs --corpus \"${UCZ_CORPUS:-../corpus/text}\" --out bench-out/aitdcc",
    "cli": "node dist/cli.js",
    "inspect": "node dist/cli.js inspect",
    "build:web": "vite build",
    "release:html": "npm run build:web && node scripts/package-release.mjs",
    "bench:quick": "node scripts/bench-public.mjs",
    "snn": "node scripts/run-snn.mjs",
    "bench:cm-cnn": "node src/lib/vision/cm-cnn-accel.ts",
    "test:cm-cnn": "node --test src/__tests__/cm-cnn-accel.test.ts",
    "bench:cm-cnn:universal": "node src/lib/vision/cm-cnn-universal.ts",
    "test:cm-cnn:universal": "node --test src/__tests__/cm-cnn-universal.test.ts",
    "test:snn": "node tests/run-snn.mjs",
    "prepack": "npm run build",
    "prebench:quick": "node -e \"try{require('node:fs').accessSync('dist/index.js')}catch{console.error('[bench] dist/index.js missing - run npm run build first');process.exit(2)}\"",
    "snn:validation": "node scripts/run-snn-validation.mjs",
    "snn:predict": "node scripts/run-snn-predict.mjs",
    "snn:class": "node scripts/run-snn-class.mjs",
    "snn:prototype": "node scripts/run-snn-prototype.mjs",
    "snn:stream": "node scripts/run-snn-stream.mjs",
    "snn:stream-predict": "node scripts/run-snn-stream-predict.mjs",
    "snn:continual": "node scripts/run-snn-continual.mjs",
    "snn:continual-predict": "node scripts/run-snn-continual-predict.mjs",
    "snn:continual-check": "node scripts/run-snn-continual-check.mjs",
    "snn:sequence": "node scripts/run-snn-sequence.mjs",
    "snn:sequence-resume": "node scripts/run-snn-sequence-resume.mjs",
    "snn:sequence-coarse": "node scripts/run-snn-sequence-coarse.mjs",
    "bench:cm-cnn:enterprise": "./experiments/cm-cnn-enterprise/cm_enterprise_avx512 --model ${CM_MODEL:-resnet18} --w0 experiments/cm-cnn-universal/pretrained_${CM_MODEL:-resnet18}_rgb.bin --w1 experiments/cm-cnn-enterprise/pruned_${CM_MODEL:-resnet18}_rgb.bin --test experiments/cm-cnn-rgb-v4/dataset/test.bin --dev experiments/cm-cnn-rgb-v4/dataset/dev.bin --stream experiments/cm-cnn-rgb-v4/dataset/stream.bin --reps 10 --reps-stream 2 --json /tmp/ent_${CM_MODEL:-resnet18}.json",
    "test:cm-cnn:enterprise": "node --test src/__tests__/cm-cnn-enterprise.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "2.3.0"
  },
  "bin": {
    "ucz": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/types",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "BENCHMARKS.md",
    "CONSTITUTION.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "license": "MPL-2.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
