{
  "name": "cm-cnn-accel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Microarchitecture-aware spatial and temporal computation skipping for CNN inference on AVX-512 CPUs (paper 1 artefacts).",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bench:cm-cnn": "node src/lib/vision/cm-cnn-accel.ts",
    "bench:cm-cnn:universal": "node src/lib/vision/cm-cnn-universal.ts",
    "bench:cm-cnn:enterprise": "./experiments/cm-cnn-enterprise/cm_enterprise_avx512 --model ${CM_MODEL:-resnet18} --w0 experiments/cm-cnn-universal/pretrained_${CM_MODEL:-resnet18}_rgb.bin --w1 experiments/cm-cnn-enterprise/pruned_${CM_MODEL:-resnet18}_rgb.bin --test experiments/cm-cnn-rgb-v4/dataset/test.bin --dev experiments/cm-cnn-rgb-v4/dataset/dev.bin --stream experiments/cm-cnn-rgb-v4/dataset/stream.bin --reps 10 --reps-stream 2 --json /tmp/ent_${CM_MODEL:-resnet18}.json",
    "test:cm-cnn": "node --test src/__tests__/cm-cnn-accel.test.ts",
    "test:cm-cnn:universal": "node --test src/__tests__/cm-cnn-universal.test.ts",
    "test:cm-cnn:production": "node --test src/__tests__/cm-cnn-production.test.ts",
    "test:cm-cnn:enterprise": "node --test src/__tests__/cm-cnn-enterprise.test.ts",
    "test:cm-cnn:all": "node --test src/__tests__/cm-cnn-*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3"
  }
}
